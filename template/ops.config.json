{
  "$schema": "node_modules/@ingeniomaps/cauce/engine/schemas/ops-config.schema.json",
  "project": "{{PROJECT_NAME}}",
  "mode": "{{MODE}}",
  "workspaceRoots": [
    { "name": "main", "path": "{{WORKSPACE_PATH}}" }
  ],
  "runner": {
    "maxTaskHours": 4,
    "humanCheckpointBetweenMilestones": true,
    "commitPerTask": true,
    "allowPush": false
  }
}
