# Molde de las credenciales locales. Copialo a `.env` y completá los valores.
# `.env` está gitignoreado; este archivo no, así que nunca escribas un valor real acá.
# El repositorio es público: un token filtrado queda expuesto al mundo.

# Cuenta de GitHub con permiso de push sobre ingeniomaps/cauce.
GITHUB_USER_CAUCE=

# Personal Access Token de esa cuenta. Scope mínimo: repo (o Contents: read/write en un fine-grained).
# Lo lee el helper declarado en `.gitconfig`, que se activa por el include condicional de ~/.gitconfig.
GITHUB_PAT_CAUCE=

# Token de npm para publicar. Debe saltear 2FA: usá un token "Automation" (clásico) o uno
# "Granular" con la opción de bypass activada. Sin eso npm pide OTP igual.
# `.npmrc` lo expande desde el entorno, no desde este archivo: exportalo antes de `npm publish`.
NPM_TOKEN=
