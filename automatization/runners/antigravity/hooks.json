{
  "cauce": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node hook.js pre-shell", "timeout": 120 }
        ]
      },
      {
        "matcher": "read_file",
        "hooks": [
          { "type": "command", "command": "node hook.js pre-read", "timeout": 30 }
        ]
      },
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node hook.js pre-files", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      { "type": "command", "command": "node hook.js stop", "timeout": 120 }
    ]
  }
}
