{
  "schemaVersion": 1,
  "name": "antigravity",
  "command": "agy",
  "config": {
    "source": "hooks.json",
    "target": ".agents/plugins/cauce/hooks.json"
  },
  "instructions": [],
  "artifacts": [
    {
      "source": "plugin.json",
      "target": ".agents/plugins/cauce/plugin.json"
    },
    {
      "source": "hook.js",
      "target": ".agents/plugins/cauce/hook.js"
    },
    {
      "source": "rules/cauce.md",
      "target": ".agents/plugins/cauce/rules/cauce.md"
    },
    {
      "source": "skills/autobuild/SKILL.md",
      "target": ".agents/plugins/cauce/skills/autobuild/SKILL.md"
    },
    {
      "source": "skills/integration-sync/SKILL.md",
      "target": ".agents/plugins/cauce/skills/integration-sync/SKILL.md"
    },
    {
      "source": "skills/integration-promote/SKILL.md",
      "target": ".agents/plugins/cauce/skills/integration-promote/SKILL.md"
    },
    {
      "source": "skills/team/SKILL.md",
      "target": ".agents/plugins/cauce/skills/team/SKILL.md"
    },
    {
      "source": "skills/onboard/SKILL.md",
      "target": ".agents/plugins/cauce/skills/onboard/SKILL.md"
    }
  ],
  "capabilities": {
    "nativeHooks": true,
    "nativeWorkflows": true,
    "projectInstructions": true,
    "checkpointing": false,
