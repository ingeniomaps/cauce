{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Ops engine configuration",
  "type": "object",
  "required": ["project", "mode", "planningDir", "workspaceRoots", "runner"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["embedded", "sidecar", "toolkit"] },
    "planningDir": { "type": "string", "minLength": 1 },
    "workspaceRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "runner": {
      "type": "object",
      "required": ["maxTaskHours", "humanCheckpointBetweenMilestones", "commitPerTask", "allowPush"],
      "properties": {
        "maxTaskHours": { "type": "number", "exclusiveMinimum": 0 },
        "humanCheckpointBetweenMilestones": { "type": "boolean" },
        "commitPerTask": { "type": "boolean" },
        "allowPush": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
